---
# Set this to the cluster defined in /etc/ood/config/clusters.d/ that sessions
# should run on. A site offering more than one can turn it into a select
# widget instead.
cluster: "slurm"

attributes:
  bc_queue:
    label: "Partition"
    help: "Leave empty for the cluster's default partition."

  bc_num_hours:
    widget: number_field
    label: "Hours"
    value: 4
    min: 1
    max: 24
    step: 1

  num_cores:
    widget: number_field
    label: "Cores"
    value: 2
    min: 1
    max: 16
    step: 1

  memory_gb:
    widget: number_field
    label: "Memory (GB)"
    value: 8
    min: 4
    max: 64
    step: 2
    help: |
      Studio itself needs roughly 2 GB; the rest is headroom for your work.

  studio_home:
    widget: text_field
    label: "Studio directory"
    value: ""
    help: |
      Where Studio keeps your workflows, its settings and the configuration of
      its AI tools. Studio uses it as its home directory, so it never writes
      to your real home. Leave empty for the site default (`~/pegasus-studio`
      unless your site changed it). It must be on storage the HTCondor submit
      host can also see, and it cannot be your home directory itself.

      Only one session per Studio directory runs at a time. Reconnect to a
      running one from *My Interactive Sessions* rather than launching a
      second.

# NB: there is no "static" widget in OnDemand. Standing text belongs in
# manifest.yml's description or in a field's `help`; a `widget: static`
# attribute raises `undefined method 'static'` and the whole form 500s.
form:
  - bc_queue
  - bc_num_hours
  - num_cores
  - memory_gb
  - studio_home
