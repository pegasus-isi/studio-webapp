Bootstrap: docker
From: rockylinux:9

# ============================================================
# PegasusAI Studio — EL9 Apptainer/Singularity definition
# ============================================================
#
# Same product as ../Dockerfile (nginx+supervisord fronting studio-api,
# studio-web, and JupyterLab, plus HTCondor, Pegasus WMS, and Apptainer for
# running workflow job containers) — packaged for Open OnDemand instead of
# K8s/KubeSpawner. This is the container image; the OOD batch-connect app
# that launches it is the rest of ood-app/ (see README.md there).
#
# Build (from the repo root — %files sources below are resolved relative to
# the current working directory, not this .def file's location):
#   apptainer build --build-arg KNOWLEDGE_REF=main \
#       ood-app/studio-el9.sif ood-app/studio-el9.def
#
# Run — always with a Studio directory as the home (#482):
#   mkdir -p ~/pegasus-studio && apptainer run --home ~/pegasus-studio --bind "$HOME" \
#       --env STUDIO_HOME="$HOME/pegasus-studio" ood-app/studio-el9.sif
#
# Not a bare `apptainer run`: Apptainer binds the user's real $HOME by
# default, and everything entrypoint.sh and studio-api write is $HOME-relative
# (the SQLite db, the marketplace checkout, ~/.pegasusrc, and the codex/
# opencode/claude configs the knowledge adapters generate). On a cluster that
# overwrites the user's own setup of those tools. --home gives Studio a home
# of its own, as the KubeSpawner volume does in K8s.
#

%arguments
    KNOWLEDGE_REF=main
    KNOWLEDGE_REPO=https://github.com/pegasus-isi/claude-plugin-marketplace.git
    ENABLE_PEGASUS_BOT_CLIENT=1

%files
    studio-api /opt/studio-api
    studio-web /opt/build/studio-web
    docker /opt/build/docker
    knowledge/overlay /opt/pegasus-ai/overlay
    jupyter-pegasusai-chat /opt/jupyter-pegasusai-chat
    jupyter-pegasus-ai-client /opt/jupyter-pegasus-ai-client

%post
#!/bin/bash
set -euo pipefail

# This targets x86_64 only, same as the Dockerfile (HTCondor/Pegasus/
# Apptainer EL9 packages below are pulled as x86_64 specifically).
if [ "$(uname -m)" != "x86_64" ]; then
    echo "[build] ERROR: unsupported arch '$(uname -m)' — build on x86_64" >&2
    exit 1
fi

# Skip weak deps (Recommends) globally. Without this, `dnf install pegasus`
# alone drags in ~300 MB of unrelated packages (NetworkManager, GNOME/GTK
# theming, printer/audio stacks, desktop-portal, fonts) via its Recommends
# chain, on a headless container that will never use any of it. Verified by
# an actual sandbox build — the dependency list included things like
# adwaita-icon-theme and pipewire that have nothing to do with Pegasus.
echo "install_weak_deps=False" >> /etc/dnf/dnf.conf

# ---- EPEL + CodeReady Builder (devel headers, Apptainer) ----
dnf install -y epel-release dnf-plugins-core
dnf config-manager --set-enabled crb || true

# ---- nginx and Node.js ship as AppStream module streams on EL9 ----
dnf -y module enable nginx:1.24
dnf -y module enable nodejs:20

# ---- System packages ----
# RHEL/AppStream equivalents of the Dockerfile's apt list:
#   libnss-sss -> sssd-client, xz-utils -> xz, vim -> vim-enhanced,
#   build-essential -> gcc/gcc-c++/make (+ python3-devel below),
#   software-properties-common -> not needed (repo files are written
#   directly here, same as the Dockerfile does for HTCondor/Pegasus/
#   NodeSource, so there's nothing to add-apt-repository).
# --allowerasing: Rocky's base image ships curl-minimal (a slimmed-down
# libcurl build with no OpenSSL/LDAP support), which conflicts with the
# full curl package below — swap it out rather than skip the package.
# npm is listed explicitly: with weak deps disabled above, RHEL9's nodejs
# package no longer drags it in as a Recommends — verified against a real
# build, where `npm install -g opencode-ai` then failed with "npm: command
# not found" despite `node --version` working fine one line earlier.
# python3.12 is installed alongside base python3 explicitly (not left to
# arrive incidentally as a pegasus dependency later) — see the Python note
# up top; everything below that touches pip uses it explicitly.
dnf install -y --allowerasing \
    sssd-client \
    nginx \
    xz \
    curl \
    wget \
    git \
    vim-enhanced \
    poppler-utils \
    gcc \
    gcc-c++ \
    make \
    python3 \
    python3-pip \
    python3-devel \
    python3.12 \
    python3.12-devel \
    nodejs \
    npm \
    apptainer


# ---- pip (python3.12) ----
# RHEL's rpm-installed pip carries proper RECORD metadata (the Dockerfile's
# get-pip.py rebootstrap works around a Debian-only gap where apt-installed
# packages lack RECORD files and block pip from upgrading — not a problem
# here). Just clear the PEP 668 externally-managed marker if present so pip
# can install system-wide, same as every other package in this image.
#
# python3.12 ships pip only as a bundled wheel (python3.12-pip-wheel), not
# a ready `pip3.12` binary — ensurepip installs it from that wheel.
# Idempotent if pip already works.
rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED /usr/lib64/python3.*/EXTERNALLY-MANAGED
python3.12 -m ensurepip --upgrade
python3.12 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# docker/entrypoint.sh (reused as-is below) finds its interpreter via
# `which python3` to run init_db.py/propagate_llm.py — both of which import
# studio-api's deps, which now live only in python3.12's site-packages.
# Deliberately NOT repointing /usr/bin/python3 itself (e.g. via
# alternatives) to avoid breaking dnf, which is itself a python3.9 script
# on EL9 — instead add a python3.12 symlink earlier on PATH, in
# /usr/local/bin, which `which`/bare `python3` finds first without moving
# anything dnf depends on.
ln -sf /usr/bin/python3.12 /usr/local/bin/python3
ln -sf /usr/bin/python3.12 /usr/local/bin/python

# ---- JupyterLab + extensions ----
# jupyter-ai is intentionally NOT installed — see ../Dockerfile for why
# (its RTC frontend extensions 403-loop behind a reverse proxy).
python3.12 -m pip install --no-cache-dir \
    "jupyterlab>=4.2" \
    jupyterlab-git \
    notebook \
    ipykernel \
    numpy \
    pandas \
    matplotlib \
    scipy \
    pypdf

# Defensive: strip any RTC/collaboration packages that slipped in
# transitively — same rationale as the Dockerfile.
python3.12 -m pip uninstall -y \
    jupyter-collaboration jupyter-collaboration-ui jupyter-docprovider \
    jupyter-server-ydoc jupyter-server-documents \
    jupyterlab-notebook-awareness jupyterlab-chat \
    || true

install -Dm644 /opt/build/docker/jupyter/jupyter_server_config.py \
    /etc/jupyter/jupyter_server_config.py

# ---- supervisord ----
python3.12 -m pip install --no-cache-dir supervisor
install -Dm644 /opt/build/docker/supervisor/supervisord.conf \
    /etc/supervisor/supervisord.conf
mkdir -p /etc/supervisor/scripts
cp /opt/build/docker/supervisor/scripts/*.sh /etc/supervisor/scripts/
chmod +x /etc/supervisor/scripts/*.sh

# ---- HTCondor (EL9 RPM repo, personal pool) ----
dnf install -y \
    https://htcss-downloads.chtc.wisc.edu/repo/25.x/htcondor-release-current.el9.noarch.rpm
dnf install -y condor
install -Dm644 /opt/build/docker/htcondor/90-studio.conf \
    /etc/condor/config.d/90-studio.conf

# ---- Pegasus ----
# gpgcheck=0, matching the Dockerfile's own `trusted=yes` for this exact
# feed: verified against a real build that this development/6.0 nightly
# channel does not produce consistently-signed packages — gpgcheck=1 here
# hard-fails with "GPG check FAILED" on an otherwise-good download. Not a
# posture this port introduces; it's what the upstream dev channel requires.
cat > /etc/yum.repos.d/pegasus.repo <<'EOF'
[pegasus]
name=Pegasus
baseurl=https://download.pegasus.isi.edu/pegasus/development/6.0/rhel/9/x86_64/
enabled=1
gpgcheck=0
EOF
dnf install -y pegasus
pegasus-version
install -Dm644 /opt/build/docker/pegasus/pegasus.properties \
    /etc/pegasus/pegasus.properties
# Studio's own pool as a hosted-style site catalog (#474); see the Dockerfile.
install -Dm644 /opt/build/docker/pegasus/site-catalogs/pegasus-studio.yml \
    "/opt/studio/site-catalogs/$(pegasus-version | cut -d. -f1,2)/conf/pegasus-studio.yml"

# Pin Pegasus's CLI tools to python3.12, the interpreter this image's
# pip/Jupyter stack uses throughout (see the python3.12 packages note
# above) — required by %test below, and by anything at runtime that reads
# pegasus.conf's agent settings through it.
PEGASUS_PYTHON=/usr/bin/python3.12
echo "export PEGASUS_PYTHON=${PEGASUS_PYTHON}" >> "${APPTAINER_ENVIRONMENT}"

# ---- Apptainer (Singularity) container runtime ----
# Installed via EPEL above. pegasus-lite probes for the `singularity`
# command name specifically — provide a compat symlink so it finds
# apptainer regardless of which name it looks for.
command -v singularity >/dev/null 2>&1 || ln -sf /usr/bin/apptainer /usr/bin/singularity

# ---- Node.js runtime (for Next.js standalone server) ----
node --version

# ---- npm global prefix ----
# AI tools (Claude Code, OpenCode, Codex CLI, …) install on-demand via
# `npm install -g`. Fixed path under /opt, writable by any uid.
mkdir -p /opt/npm-global
chmod 777 /opt/npm-global
export NPM_CONFIG_PREFIX=/opt/npm-global
export PATH="/opt/npm-global/bin:${PATH}"

# ---- default AI tools ----
npm install -g opencode-ai@1.18.8
opencode --version
chmod -R a+rwX /opt/npm-global
npm cache clean --force

# ---- interactive shell env for on-demand AI tools ----
# RHEL/Rocky's bash reads /etc/bashrc for interactive non-login shells (the
# Dockerfile's /etc/bash.bashrc is Debian's equivalent).
cat > /etc/profile.d/10-studio-tools.sh <<'EOF'
export NPM_CONFIG_PREFIX="$HOME/.npm-global"
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:/opt/npm-global/bin:$PATH"
EOF
chmod 0644 /etc/profile.d/10-studio-tools.sh
cat /etc/profile.d/10-studio-tools.sh >> /etc/bashrc

# ---- PegasusAI Chat JupyterLab extension ----
cd /opt/jupyter-pegasusai-chat
touch yarn.lock
# `jlpm install` has intermittently segfaulted here during Yarn's Fetch step
# (SIGSEGV, exit 139) on some build hosts — not root-caused; not
# environment/QEMU/noexec/cgroup-limit related (see build notes). Capping
# fetch concurrency reduces parallel-network-worker pressure during that
# step, and the retry loop is cheap insurance against whatever residual
# flakiness remains, since `set -e` above means one segfault otherwise
# kills the whole build.
export YARN_NETWORK_CONCURRENCY=4
for attempt in 1 2 3; do
    if jlpm install; then
        break
    fi
    echo "[build] jlpm install failed (attempt ${attempt}/3), retrying..." >&2
    [ "${attempt}" -eq 3 ] && exit 1
    sleep 5
done
jlpm build:lib:prod
jupyter labextension build --development True .
EXTDIR="$(python3.12 -c 'import sys, os; print(os.path.join(sys.prefix, "share", "jupyter", "labextensions", "jupyter-pegasusai-chat"))')"
mkdir -p "${EXTDIR}"
cp -r jupyter_pegasusai_chat/labextension/* "${EXTDIR}/"
chmod -R a+rX "${EXTDIR}"
rm -rf node_modules .yarn /root/.yarn /root/.cache/yarn /usr/local/share/.cache/yarn

# ---- PegasusAI Bot cell-toolbar client (optional, vendored) ----
if [ "{{ ENABLE_PEGASUS_BOT_CLIENT }}" = "1" ]; then
    cd /opt/jupyter-pegasus-ai-client
    # Its build backend (hatch-jupyter-builder) declares Requires-Python
    # >=3.10 — this is the component that first surfaced the need for
    # python3.12 across this whole image (see the Python note up top).
    python3.12 -m pip install --no-cache-dir .
    rm -rf node_modules .yarn lib tsconfig.tsbuildinfo \
           /root/.yarn /root/.cache/yarn /usr/local/share/.cache/yarn
else
    echo "[build] PegasusAI Bot client disabled (ENABLE_PEGASUS_BOT_CLIENT=0)"
fi

# ---- Studio API (Python backend) ----
python3.12 -m pip install --no-cache-dir -r /opt/studio-api/requirements.txt

# ---- Studio Web (Next.js standalone) ----
# Single-stage build: Node is already on PATH for the runtime server, so
# unlike the Dockerfile's separate frontend-build stage there's nothing
# gained by splitting this out. Trim /build down to just the standalone
# output afterward.
cd /opt/build/studio-web
npm ci --ignore-scripts 2>/dev/null || npm install
npm run build
mkdir -p /opt/studio-web
cp -r /opt/build/studio-web/.next/standalone/. /opt/studio-web/
mkdir -p /opt/studio-web/.next
cp -r /opt/build/studio-web/.next/static /opt/studio-web/.next/static
cp -r /opt/build/studio-web/public /opt/studio-web/public
# cd out before removing /opt/build: the shell is still sitting in
# /opt/build/studio-web from the `cd` above, and rm -rf'ing the directory a
# process's cwd points at leaves it unable to resolve a working directory
# at all — confirmed by a real build, where the next command (git clone,
# below) failed with "Unable to read current working directory" even
# though it only takes absolute paths.
cd /opt

# ---- Nginx config templates ----
# Templates, not finished configs — matching ../Dockerfile, which moved to this
# scheme when the session-token gate (#218) and per-session port allocation
# made a single baked config wrong: every listener is rendered per session by
# entrypoint.sh into $STUDIO_RUNTIME_DIR, and nginx is started with `-c`
# against the result. They cannot be rendered into /etc here either — this
# runs as whatever uid the OOD job injects, same as KubeSpawner's uid in the
# Dockerfile's case, and /etc is not writable by it.
mkdir -p /opt/pegasus-ai/templates
cp /opt/build/docker/nginx/*.conf.tmpl /opt/pegasus-ai/templates/
# The distro ships a default vhost listening on :80 in conf.d (RHEL has no
# Debian-style sites-available/sites-enabled convention — that symlink is
# created by Debian's nginx-common postinst — so conf.d is the only spot to
# clear). Nothing includes it now that nginx runs from the rendered config,
# but leaving it in the image invites someone to start nginx without `-c` and
# get a server that answers on the wrong port with none of Studio's routes.
rm -f /etc/nginx/conf.d/default.conf

# ---- Knowledge assets (skills, agents, MCP, templates, examples) ----
# Authored in pegasus-isi/claude-plugin-marketplace and checked out here —
# see ../Dockerfile for the full rationale (single source of truth; the
# entrypoint clones this seed into the user's own $HOME on first launch,
# where it's writable and survives restarts).
git clone --quiet "{{ KNOWLEDGE_REPO }}" /opt/pegasus-ai/marketplace
git -C /opt/pegasus-ai/marketplace checkout --quiet "{{ KNOWLEDGE_REF }}"
git -C /opt/pegasus-ai/marketplace log -1 --format='knowledge %H %s'
test -f /opt/pegasus-ai/marketplace/plugins/pegasus-ai/.mcp.json
chmod -R a+rX /opt/pegasus-ai/marketplace
git config --system --add safe.directory /opt/pegasus-ai/marketplace
git config --system --add safe.directory /opt/pegasus-ai/marketplace/.git
echo "export KNOWLEDGE_REPO_URL={{ KNOWLEDGE_REPO }}" >> "${APPTAINER_ENVIRONMENT}"

# knowledge/overlay/ (Studio-specific context) already placed by %files at
# /opt/pegasus-ai/overlay.

# ---- Entrypoint ----
install -Dm755 /opt/build/docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# Validate the rendered nginx configuration at build time, same as the
# Dockerfile does right after it installs entrypoint.sh. The templates above
# are only exercised at session start, so a syntax error in one would
# otherwise first appear as a container that boots with no proxy — and nginx
# reports it by line number, from a file that does not exist until the
# session runs. --render-only stops before anything touches $HOME, so this
# leaves no state behind (root's home at build time).
STUDIO_RUNTIME_DIR=/tmp/nginx-validate /usr/local/bin/entrypoint.sh --render-only
nginx -t -c /tmp/nginx-validate/nginx.conf
rm -rf /tmp/nginx-validate

# And again with the session token gate on. The gate fragments render to bare
# comments by default, so the pass above never parses a single one of their
# directives — a broken map, `if` or location in them would first surface on a
# multi-user shared host, which is the one deployment this .def file targets.
# The prefix is set too, since it changes the rendered regexes.
STUDIO_RUNTIME_DIR=/tmp/nginx-validate-gate \
    STUDIO_AUTH_TOKEN=buildtimevalidationtoken \
    STUDIO_URL_PREFIX=/node/example/12345 \
    /usr/local/bin/entrypoint.sh --render-only
nginx -t -c /tmp/nginx-validate-gate/nginx.conf
rm -rf /tmp/nginx-validate-gate

rm -rf /opt/build

%environment
    export NPM_CONFIG_PREFIX=/opt/npm-global
    export PATH="/opt/npm-global/bin:${PATH}"

%runscript
    exec /usr/local/bin/entrypoint.sh "$@"

%startscript
    exec /usr/local/bin/entrypoint.sh "$@"

%test
#!/bin/bash
set -euo pipefail
grep -qi rocky /etc/os-release
pegasus-version
condor_version
# Not a bare `nginx -t`: that tests whatever sits at /etc/nginx/nginx.conf,
# which is now RHEL's untouched stock config (Studio's is template-rendered
# per session, never installed there — see the Nginx config templates note in
# %post) — and testing it fails anyway, since %test runs against the final
# read-only squashfs image and the stock config's pid/error_log paths
# (/run/nginx.pid, /var/log/nginx/error.log) live inside it. Render the real
# templates into /tmp instead, same as the %post build-time check, and
# validate that.
STUDIO_RUNTIME_DIR=/tmp/nginx-test /usr/local/bin/entrypoint.sh --render-only
nginx -t -c /tmp/nginx-test/nginx.conf
rm -rf /tmp/nginx-test
node --version
npm --version
apptainer --version
test -x "${PEGASUS_PYTHON:?PEGASUS_PYTHON not set by %post}"
"${PEGASUS_PYTHON}" --version
echo "[test] studio-el9.sif basic sanity checks passed"

%labels
    Author studio-webapp
    Base rockylinux:9
    Component pegasusai-studio-el9

%help
    PegasusAI Studio, packaged for Open OnDemand.

    Full-parity port of ../Dockerfile: nginx + supervisord fronting
    studio-api, studio-web, and JupyterLab, plus HTCondor (personal pool),
    Pegasus WMS, and Apptainer (for running workflow job containers).

    Build (from the repo root):
        apptainer build ood-app/studio-el9.sif ood-app/studio-el9.def

    Run, with a directory of its own as the home so Studio never writes
    into your real one:
        mkdir -p ~/pegasus-studio && apptainer run --home ~/pegasus-studio --bind "$HOME" \
            --env STUDIO_HOME="$HOME/pegasus-studio" ood-app/studio-el9.sif

    Nginx listens on :8888 (STUDIO_PORT), same as the Docker image. There is
    no built-in auth: the OOD batch-connect app in ood-app/ fronts the
    session per-user, the same role KubeSpawner plays for the K8s
    deployment.
