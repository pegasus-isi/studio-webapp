# Batch-connect preamble, sourced by the job script before script.sh runs.
#
# The batch-connect template exports `find_port` and `create_passwd` as shell
# functions but does NOT choose a port or secret for the app: it only writes
# whatever $host/$port/$password hold into connection.yml. An app that assumes
# those are pre-set gets a connection.yml with empty port and password, and a
# session that can never be connected to.
port=$(find_port)
# The entrypoint refuses a token outside [A-Za-z0-9_-] (it lands in a sed
# replacement, an nginx regex and a cookie). Normalize ONCE, here, and let the
# normalized value be $password itself: connection.yml then carries the exact
# string the gate expects, so view.html.erb can use it verbatim. Normalizing
# in both places instead would be two copies of one rule that must agree, and
# the failure mode when they drift is a Connect button that 403s.
password=$(create_passwd | tr -c 'A-Za-z0-9_-' '-')
export port password

# This is what turns the whole gate on: proxy cookie check, loopback binds, a
# real Jupyter token, and the API's internal-secret requirement.
export STUDIO_AUTH_TOKEN="${password}"

# Front port for this session. The internal listeners are allocated by the
# entrypoint itself (STUDIO_ALLOC_PORTS): Apptainer shares the host network
# namespace, so fixed ports would collide with another user on the same node.
export STUDIO_PORT="${port}"
export STUDIO_ALLOC_PORTS=1

# OOD proxies the session at /node/<host>/<port>/. Studio renders its proxy
# locations for exactly that prefix and announces it via X-Forwarded-Prefix.
# ${host} rather than a fresh `hostname`: the template sets it (from the
# cluster's `set_host`, `hostname` by default) before sourcing this file, and
# it is the value connection.yml and so the portal's proxy use. A site whose
# set_host differs from `hostname` would otherwise get a prefix that matches
# nothing.
export STUDIO_URL_PREFIX="/node/${host:-$(hostname)}/${port}"
