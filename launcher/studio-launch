#!/usr/bin/env bash
# studio-launch — the single "how Studio starts" entry point.
#
# Both packagings call this: the container entrypoint (docker/entrypoint.sh) is
# a thin wrapper around it, and the native Open OnDemand packaging invokes it
# directly from a batch-connect job script. Keeping one start path is the whole
# point — a copied entrypoint would drift, the same failure mode the knowledge
# base had when two copies gave different advice per tool.
# Design: docs/OOD-DEPLOYMENT-DESIGN.md (§1, §8.1).
#
# Three phases:
#   prepare — per-user $HOME state (~/.studio, ~/work, marketplace clone,
#             init_db, AGENTS.md, pegasus.conf). First launch IS provisioning.
#   render  — supervisord + proxy configs from launcher/templates into a
#             session runtime dir, substituting @VAR@ placeholders from env.
#   exec    — supervisord (proxy, Next.js, FastAPI, JupyterLab). opencode serve
#             is NOT supervised: studio-api spawns and owns it
#             (services/opencode_engine.py, STUDIO_OPENCODE_BIN/_PORT).
#
# Environment contract (defaults reproduce the container exactly):
#   STUDIO_PORT            front proxy listen port          (8888)
#   STUDIO_API_PORT        uvicorn listener                 (8080)
#   STUDIO_WEB_PORT        Next.js standalone listener      (3000)
#   STUDIO_JUPYTER_PORT    JupyterLab listener              (8889)
#   STUDIO_OPENCODE_PORT   opencode serve listener          (4747)
#   STUDIO_ALLOC_PORTS     =1: pick free ports per session for any of the
#                          four internal listeners not set explicitly —
#                          required on shared native hosts where fixed ports
#                          are host-global and collide between users
#   STUDIO_URL_PREFIX      literal URL prefix the app is served under, e.g.
#                          OOD's /node/<host>/<port>. Empty (default) = root.
#                          K8s' /user/<name> needs no setting here — it stays
#                          regex-matched in the proxy template (per-user).
#   STUDIO_AUTH_TOKEN      session token gate. Unset (default): no gate, the
#                          K8s/container behavior. Set: the proxy 403s all
#                          requests without the session cookie (GET
#                          /auth?token=... sets it), internal services bind
#                          127.0.0.1, JupyterLab gets a real token, and
#                          studio-api requires the proxy-stamped
#                          X-Studio-Internal secret. [A-Za-z0-9_-] only.
#   STUDIO_BIND_ADDR       internal bind address; defaults 0.0.0.0 without
#                          the gate, 127.0.0.1 with it
#   STUDIO_API_DIR         FastAPI app dir                  (/opt/studio-api)
#   STUDIO_WEB_DIR         Next.js standalone dir           (/opt/studio-web)
#   STUDIO_RUNTIME_DIR     rendered configs, pids, sockets  (/tmp/studio-runtime-<uid>)
#   STUDIO_KNOWLEDGE_SEED  marketplace clone source         (/opt/pegasus-ai/marketplace)
#   STUDIO_OVERLAY         Studio env overlay for AGENTS.md (/opt/pegasus-ai/overlay/STUDIO_ENV.md)
#   STUDIO_PEGASUS_AGENT_URL  pegasus.agent.url value       (https://api.pegasus-ai.org)
# Everything the services read themselves (STUDIO_LLM_GATEWAY_URL,
# STUDIO_SECRET_KEY[_FILE], STUDIO_OPENCODE_*, _CONDOR_*, JUPYTERHUB_*) is
# plain pass-through: supervisord children inherit this process's environment.
#
# Usage: studio-launch [--render-only]
#   --render-only  render configs into STUDIO_RUNTIME_DIR and exit; no $HOME
#                  writes, no DB init, no exec. Lets tests verify the rendered
#                  output on any machine without Docker or the app dirs.
#
# Runs as whatever UID invoked it — no root assumed (KubeSpawner injects an
# arbitrary uid; OOD runs it as the login user).

set -euo pipefail

LAUNCHER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATES="${LAUNCHER_DIR}/templates"

STUDIO_PORT="${STUDIO_PORT:-8888}"
STUDIO_API_DIR="${STUDIO_API_DIR:-/opt/studio-api}"
STUDIO_WEB_DIR="${STUDIO_WEB_DIR:-/opt/studio-web}"

PYTHON="$(which python3 2>/dev/null || which python 2>/dev/null || echo python3)"

# ---- Internal listener ports ----
# Fixed defaults reproduce the container, where the pod network namespace made
# collisions impossible. On a shared native host they are host-global: two
# users' sessions would fight over 8080/3000/8889/4747 at the very first bind.
# A native site sets STUDIO_ALLOC_PORTS=1 (or explicit values — explicit env
# always wins) and the launcher picks free ports per session instead.
#
# All four are allocated in ONE python process holding the sockets open
# together: allocating one at a time lets the kernel hand the same ephemeral
# port back after each close.
if [ "${STUDIO_ALLOC_PORTS:-0}" = "1" ]; then
    read -r ALLOC1 ALLOC2 ALLOC3 ALLOC4 <<EOF_PORTS
$("${PYTHON}" -c 'import socket
socks = [socket.socket() for _ in range(4)]
for s in socks: s.bind(("127.0.0.1", 0))
print(" ".join(str(s.getsockname()[1]) for s in socks))
for s in socks: s.close()')
EOF_PORTS
    STUDIO_API_PORT="${STUDIO_API_PORT:-${ALLOC1}}"
    STUDIO_WEB_PORT="${STUDIO_WEB_PORT:-${ALLOC2}}"
    STUDIO_JUPYTER_PORT="${STUDIO_JUPYTER_PORT:-${ALLOC3}}"
    STUDIO_OPENCODE_PORT="${STUDIO_OPENCODE_PORT:-${ALLOC4}}"
fi
STUDIO_API_PORT="${STUDIO_API_PORT:-8080}"
STUDIO_WEB_PORT="${STUDIO_WEB_PORT:-3000}"
STUDIO_JUPYTER_PORT="${STUDIO_JUPYTER_PORT:-8889}"
STUDIO_OPENCODE_PORT="${STUDIO_OPENCODE_PORT:-4747}"
# API and web ports are baked into the rendered configs; these two are read
# from env at runtime instead — jupyter.sh and routers/jupyter.py
# (STUDIO_JUPYTER_PORT), services/opencode_engine.py (STUDIO_OPENCODE_PORT) —
# so they must reach supervisord's children.
export STUDIO_JUPYTER_PORT STUDIO_OPENCODE_PORT

# ---- URL prefix ----
# Under OOD the app is served at a literal prefix (/node/<host>/<port>);
# under K8s at /user/<name>, which stays regex-matched in the proxy template
# because it is per-user and cannot be a literal. Empty (the default) renders
# no prefix locations at all. Normalized: no trailing slash — "/" collapses
# to empty, i.e. "serve at root", which is already the default behavior.
STUDIO_URL_PREFIX="${STUDIO_URL_PREFIX:-}"
STUDIO_URL_PREFIX="${STUDIO_URL_PREFIX%/}"
if [ -n "${STUDIO_URL_PREFIX}" ]; then
    case "${STUDIO_URL_PREFIX}" in
        /*) : ;;
        *)
            echo "[studio-launch] FATAL: STUDIO_URL_PREFIX must start with" \
                 "'/' (got '${STUDIO_URL_PREFIX}')" >&2
            exit 1
            ;;
    esac
    # JupyterLab serves AT the prefix; jupyter.sh reads this. KubeSpawner's
    # JUPYTERHUB_SERVICE_PREFIX still supersedes it there, so the K8s path is
    # untouched even if both are somehow set.
    export STUDIO_JUPYTER_BASE_URL="${STUDIO_JUPYTER_BASE_URL:-${STUDIO_URL_PREFIX}/jupyter/}"
fi

# ---- Session token gate ----
# Unset (the K8s/container default): no gate — the pod network namespace is
# the security boundary there. Set (OOD's before.sh generates it): the proxy
# 403s everything without the session cookie, only GET /auth?token=... sets
# it, and the backends behind the proxy are hardened too, because on a shared
# host any local user can reach them directly:
#   - every internal service binds 127.0.0.1 (STUDIO_BIND_ADDR),
#   - JupyterLab gets a real token (empty token = terminals for any local
#     user), injected by the proxy so the browser flow is unchanged,
#   - studio-api requires the proxy-stamped X-Studio-Internal secret.
STUDIO_AUTH_TOKEN="${STUDIO_AUTH_TOKEN:-}"
if [ -n "${STUDIO_AUTH_TOKEN}" ]; then
    # The token lands in a sed replacement, an nginx regex and a cookie —
    # constrain the charset so it cannot break out of any of them.
    case "${STUDIO_AUTH_TOKEN}" in
        *[!A-Za-z0-9_-]*)
            echo "[studio-launch] FATAL: STUDIO_AUTH_TOKEN may only contain" \
                 "[A-Za-z0-9_-]" >&2
            exit 1
            ;;
    esac
    STUDIO_BIND_ADDR="${STUDIO_BIND_ADDR:-127.0.0.1}"
    STUDIO_JUPYTER_TOKEN="${STUDIO_JUPYTER_TOKEN:-$("${PYTHON}" -c 'import secrets; print(secrets.token_urlsafe(32))')}"
    STUDIO_INTERNAL_SECRET="${STUDIO_INTERNAL_SECRET:-$("${PYTHON}" -c 'import secrets; print(secrets.token_urlsafe(32))')}"
    # jupyter.sh reads the token; studio-api's InternalSecretMiddleware reads
    # the secret — both are supervisord children, so export is the channel.
    export STUDIO_JUPYTER_TOKEN STUDIO_INTERNAL_SECRET
else
    STUDIO_BIND_ADDR="${STUDIO_BIND_ADDR:-0.0.0.0}"
    STUDIO_JUPYTER_TOKEN="${STUDIO_JUPYTER_TOKEN:-}"
    STUDIO_INTERNAL_SECRET="${STUDIO_INTERNAL_SECRET:-}"
fi
# Deliberately NOT under $HOME: in K8s the home is NFS-backed, and unix domain
# sockets (supervisor.sock) cannot live on NFS. /tmp is local in both models;
# the uid suffix keeps two users on one native host out of each other's dir.
# (Per-SESSION isolation — two sessions, one user — is issue #216's lockfile.)
STUDIO_RUNTIME_DIR="${STUDIO_RUNTIME_DIR:-/tmp/studio-runtime-$(id -u)}"
STUDIO_KNOWLEDGE_SEED="${STUDIO_KNOWLEDGE_SEED:-/opt/pegasus-ai/marketplace}"
STUDIO_OVERLAY="${STUDIO_OVERLAY:-/opt/pegasus-ai/overlay/STUDIO_ENV.md}"

RENDER_ONLY=0
if [ "${1:-}" = "--render-only" ]; then
    RENDER_ONLY=1
fi

# ---------------------------------------------------------------------------
# render — templates + env → $STUDIO_RUNTIME_DIR
# ---------------------------------------------------------------------------
render() {
    # Wiped and re-rendered on every start: stale configs from a previous
    # session (older template version, different port) must never win.
    # But refuse to wipe a directory this launcher didn't create — the dir is
    # rm -rf'd, so a mis-set STUDIO_RUNTIME_DIR ($HOME, say) must fail here,
    # not silently delete it. The marker is written right after mkdir.
    if [ -d "${STUDIO_RUNTIME_DIR}" ] \
       && [ ! -f "${STUDIO_RUNTIME_DIR}/.studio-launch" ] \
       && [ -n "$(ls -A "${STUDIO_RUNTIME_DIR}" 2>/dev/null)" ]; then
        echo "[studio-launch] FATAL: ${STUDIO_RUNTIME_DIR} exists, is not" \
             "empty, and was not created by studio-launch — refusing to wipe" \
             "it. Point STUDIO_RUNTIME_DIR at a disposable directory." >&2
        exit 1
    fi
    rm -rf "${STUDIO_RUNTIME_DIR}"
    mkdir -p "${STUDIO_RUNTIME_DIR}"
    # Rendered gate fragments carry session secrets; nobody else's business.
    chmod 700 "${STUDIO_RUNTIME_DIR}"
    touch "${STUDIO_RUNTIME_DIR}/.studio-launch"
    # Nginx temp dirs must exist before nginx starts (non-root can't create
    # them under /var/lib/nginx; the rendered nginx.conf points here).
    mkdir -p "${STUDIO_RUNTIME_DIR}/nginx-client-body" \
             "${STUDIO_RUNTIME_DIR}/nginx-proxy" \
             "${STUDIO_RUNTIME_DIR}/nginx-fastcgi" \
             "${STUDIO_RUNTIME_DIR}/nginx-uwsgi" \
             "${STUDIO_RUNTIME_DIR}/nginx-scgi"

    # sed with | as delimiter: substituted values are ports and absolute paths,
    # which never contain |. If that assumption breaks, the leftover-@VAR@
    # check below fails loudly rather than shipping a half-rendered config.
    local tmpl out
    for tmpl in "${TEMPLATES}"/*.tmpl; do
        out="${STUDIO_RUNTIME_DIR}/$(basename "${tmpl%.tmpl}")"
        # The prefix-locations template is all literal-prefix blocks; with no
        # prefix configured, substituting an empty string would produce
        # syntactically broken locations ("location = { ... }"), so render a
        # comment-only file instead — the include in studio-proxy.conf always
        # has something to load.
        if [ "$(basename "${tmpl}")" = "prefix-locations.conf.tmpl" ] \
           && [ -z "${STUDIO_URL_PREFIX}" ]; then
            printf '# No STUDIO_URL_PREFIX configured — no prefix locations.\n' \
                > "${out}"
            continue
        fi
        # Gate fragments are directives only when the gate is on; the includes
        # that load them are unconditional, so they must always exist.
        case "$(basename "${tmpl}")" in
            gate-*.conf.tmpl)
                if [ -z "${STUDIO_AUTH_TOKEN}" ]; then
                    printf '# STUDIO_AUTH_TOKEN unset — token gate off.\n' \
                        > "${out}"
                    continue
                fi
                ;;
        esac
        sed -e "s|@STUDIO_PORT@|${STUDIO_PORT}|g" \
            -e "s|@STUDIO_URL_PREFIX@|${STUDIO_URL_PREFIX}|g" \
            -e "s|@STUDIO_AUTH_TOKEN@|${STUDIO_AUTH_TOKEN}|g" \
            -e "s|@STUDIO_JUPYTER_TOKEN@|${STUDIO_JUPYTER_TOKEN}|g" \
            -e "s|@STUDIO_INTERNAL_SECRET@|${STUDIO_INTERNAL_SECRET}|g" \
            -e "s|@STUDIO_BIND_ADDR@|${STUDIO_BIND_ADDR}|g" \
            -e "s|@STUDIO_API_PORT@|${STUDIO_API_PORT}|g" \
            -e "s|@STUDIO_WEB_PORT@|${STUDIO_WEB_PORT}|g" \
            -e "s|@STUDIO_JUPYTER_PORT@|${STUDIO_JUPYTER_PORT}|g" \
            -e "s|@STUDIO_API_DIR@|${STUDIO_API_DIR}|g" \
            -e "s|@STUDIO_WEB_DIR@|${STUDIO_WEB_DIR}|g" \
            -e "s|@STUDIO_RUNTIME_DIR@|${STUDIO_RUNTIME_DIR}|g" \
            -e "s|@LAUNCHER_SCRIPTS@|${LAUNCHER_DIR}/scripts|g" \
            "${tmpl}" > "${out}"
        # A placeholder that survives rendering means the template gained a
        # variable this script doesn't know — fail at start, not at 3am when
        # nginx rejects "@STUDIO_...@" as a listen directive.
        if grep -q '@[A-Z_][A-Z_]*@' "${out}"; then
            echo "[studio-launch] FATAL: unrendered placeholder in ${out}:" >&2
            grep -n '@[A-Z_][A-Z_]*@' "${out}" >&2
            exit 1
        fi
    done
    echo "[studio-launch] Rendered configs to ${STUDIO_RUNTIME_DIR}" \
         "(port ${STUDIO_PORT}, prefix '${STUDIO_URL_PREFIX:-<none>}')"
}

if [ "${RENDER_ONLY}" = "1" ]; then
    render
    exit 0
fi

# ---------------------------------------------------------------------------
# prepare — per-user $HOME state (previously docker/entrypoint.sh)
# ---------------------------------------------------------------------------

WORK="${HOME:-/tmp}/work"
# Studio's own state lives beside the user's other config, not inside the
# directory they keep workflows in: a `rm -rf` in the workspace should not be
# able to take the settings database with it. init_db.py migrates an existing
# database from the old location on first start.
STUDIO_DIR="${HOME:-/tmp}/.studio"
MARKER="${STUDIO_DIR}/.initialized"

# workflows/ is where the Marketplace "Add" clones into and where the scaffold
# skills are told to put projects, so it should exist before anyone looks.
mkdir -p "${WORK}" "${STUDIO_DIR}" "${WORK}/workflows"

# ---- LLM keys at rest ----
# secretbox.py encrypts stored API keys when a master secret is available
# (STUDIO_SECRET_KEY or STUDIO_SECRET_KEY_FILE — the S7 remediation). K8s
# injects STUDIO_SECRET_KEY; a lab deployment shouldn't have to manage
# secrets, so generate a per-user key file once and point the API at it.
# Before init_db.py, which may already touch encrypted values.
if [ -z "${STUDIO_SECRET_KEY:-}" ] && [ -z "${STUDIO_SECRET_KEY_FILE:-}" ]; then
    STUDIO_KEYFILE="${STUDIO_DIR}/secret.key"
    if [ ! -f "${STUDIO_KEYFILE}" ]; then
        (umask 077 && "${PYTHON}" -c 'import secrets; print(secrets.token_urlsafe(48))' \
            > "${STUDIO_KEYFILE}")
        echo "[studio-launch] Generated ${STUDIO_KEYFILE} (LLM keys at rest)"
    fi
    export STUDIO_SECRET_KEY_FILE="${STUDIO_KEYFILE}"
fi

# ---- Marketplace checkout (skills, agents, templates) ----
# The packaging ships a pinned copy (image: /opt/pegasus-ai/marketplace; native
# dist: seed/marketplace — either way $STUDIO_KNOWLEDGE_SEED). It is a template
# to copy from, not the tree tools read: it may be root-owned and is replaced
# wholesale on every image rebuild / dist upgrade.
#
# (Not to be confused with the Claude Code *plugin seed directory* written by
# knowledge/seed.py — that one points Claude Code at whichever checkout wins.)
#
# Clone it into the user's own $HOME on first launch: there it is writable, so
# skills can be updated with `git pull` or rolled back with `git checkout` —
# no root, no rebuild — and it persists across pod restarts, which a change
# under /opt would not.
#
# Cloning from the local seed rather than GitHub keeps first launch fast and
# working with no egress. origin is then repointed upstream so `git pull` does
# the obvious thing. Non-fatal throughout: layout.py falls back to the seed.
USER_MARKETPLACE="${XDG_DATA_HOME:-${HOME:-/tmp}/.local/share}/pegasus-ai/marketplace"
if [ ! -d "${USER_MARKETPLACE}/.claude-plugin" ] \
   && [ -d "${STUDIO_KNOWLEDGE_SEED}/.claude-plugin" ]; then
    CLONE_ERR=""
    if mkdir -p "$(dirname "${USER_MARKETPLACE}")" \
       && CLONE_ERR="$(git clone --quiet "${STUDIO_KNOWLEDGE_SEED}" "${USER_MARKETPLACE}" 2>&1)"; then
        git -C "${USER_MARKETPLACE}" remote set-url origin \
            "${KNOWLEDGE_REPO_URL:-https://github.com/pegasus-isi/claude-plugin-marketplace.git}" \
            2>/dev/null || true
        echo "[studio-launch] Marketplace checked out to ${USER_MARKETPLACE}"
    else
        # Print git's own message: a bare "could not create" sent one
        # investigation looking at NFS permissions when the cause was git
        # refusing the source repository's ownership.
        echo "[studio-launch] WARNING: could not create ${USER_MARKETPLACE} —" \
             "falling back to the read-only ${STUDIO_KNOWLEDGE_SEED}: ${CLONE_ERR}" >&2
    fi
fi

# The checkout is kept current by studio-api at startup, not here. Pulling from
# the launcher raced the tools that read the result: opencode loads skills once
# when it starts and never reloads, so whether the assistant got today's skills
# came down to which background job finished first, with nothing in any log to
# say which way it went. studio-api owns it now and restarts opencode when the
# checkout actually moves.

# What the tools will actually read, for the AGENTS.md seed below and the log.
if [ -d "${USER_MARKETPLACE}/plugins/pegasus-ai" ]; then
    RESOLVED_KNOWLEDGE="${USER_MARKETPLACE}/plugins/pegasus-ai"
else
    RESOLVED_KNOWLEDGE="${STUDIO_KNOWLEDGE_SEED}/plugins/pegasus-ai"
fi

if [ ! -f "${MARKER}" ]; then
    echo "[studio-launch] First launch — initializing..."

    cd "${STUDIO_API_DIR}"
    # Hard timeout: this touches the (possibly NFS-backed) SQLite DB, and a
    # stale lock from a crashed prior session (or an NFS stall) would otherwise
    # block here forever — supervisord never starts, JupyterHub kills the spawn
    # at 30s, and every retry hits the same lock. Same rationale as the timeout
    # on propagate_llm.py below, but init is a hard prerequisite, so fail loud
    # instead of backgrounding. (timeout exits 124 on timeout.)
    if ! timeout 60 "${PYTHON}" init_db.py; then
        echo "[studio-launch] FATAL: init_db.py failed or timed out (>60s) —" \
             "check for a stale SQLite lock on ${STUDIO_DIR}/studio.db" >&2
        exit 1
    fi

    touch "${MARKER}"
    echo "[studio-launch] Initialization complete."
fi

# AGENTS.md: the Studio environment overlay followed by the portable Pegasus
# guide, matching what the knowledge adapters generate.
#
# Written on every start when absent, not only on first launch. The adapters
# only create it during install(), and startup runs update_llm_config(), so a
# workspace that lost the file — a user clearing it out, say — otherwise never
# got it back and the tools ran with no Pegasus context at all.
# Written at $HOME, not $HOME/work: every tool looks in the directory it starts
# in and then upwards, and terminals start at $HOME, so a copy one directory
# down existed without being found.
CONFIG_ROOT="${HOME:-/tmp}"
GUIDE="${KNOWLEDGE_ROOT:-${RESOLVED_KNOWLEDGE}}/references/PEGASUS.md"
if [ ! -f "${CONFIG_ROOT}/AGENTS.md" ] && { [ -f "${STUDIO_OVERLAY}" ] || [ -f "${GUIDE}" ]; }; then
    # Written with explicit ifs, not `[ -f x ] && cat x`: under `set -e` a
    # failing test makes the whole && chain the script's last status and
    # kills the launcher before supervisord ever starts.
    : > "${CONFIG_ROOT}/AGENTS.md"
    if [ -f "${STUDIO_OVERLAY}" ]; then
        cat "${STUDIO_OVERLAY}" >> "${CONFIG_ROOT}/AGENTS.md"
        printf '\n' >> "${CONFIG_ROOT}/AGENTS.md"
    fi
    if [ -f "${GUIDE}" ]; then
        cat "${GUIDE}" >> "${CONFIG_ROOT}/AGENTS.md"
    fi
    echo "[studio-launch] Wrote ${CONFIG_ROOT}/AGENTS.md"
elif [ ! -f "${CONFIG_ROOT}/AGENTS.md" ]; then
    echo "[studio-launch] WARNING: no knowledge tree found — AGENTS.md not written" >&2
fi

# Pegasus agent endpoint — without it pegasus-analyzer probes the default
# agent URL and stalls badly. HOME is per-user persistent state, so this must
# be written at runtime (an image-baked copy under /home would be shadowed by
# the mount). Runs on every start, not just first launch, so existing sessions
# pick it up; appends only when the key is absent, preserving user edits.
PEGASUS_CONF="${HOME:-/tmp}/.pegasus/pegasus.conf"
PEGASUS_AGENT_URL="${STUDIO_PEGASUS_AGENT_URL:-https://api.pegasus-ai.org}"
if ! grep -qs '^pegasus\.agent\.url' "${PEGASUS_CONF}"; then
    mkdir -p "$(dirname "${PEGASUS_CONF}")"
    echo "pegasus.agent.url = ${PEGASUS_AGENT_URL}" >> "${PEGASUS_CONF}"
    echo "[studio-launch] Wrote pegasus.agent.url to ${PEGASUS_CONF}"
fi

# Propagate saved LLM config to installed tool adapters. Run in the background
# with a hard timeout so it can NEVER gate supervisord startup: this touches the
# (possibly NFS-backed) SQLite DB, and a blocked write here would otherwise
# stall the notebook server past JupyterHub's 30s spawn timeout. Non-fatal;
# logged for inspection rather than discarded.
( cd "${STUDIO_API_DIR}" && timeout 20 "${PYTHON}" propagate_llm.py \
    >"${STUDIO_DIR}/propagate_llm.log" 2>&1 || true ) &

# ---------------------------------------------------------------------------
# render + exec
# ---------------------------------------------------------------------------
render

exec supervisord -c "${STUDIO_RUNTIME_DIR}/supervisord.conf"
