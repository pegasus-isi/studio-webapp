; Rendered by launcher/studio-launch — do not edit the rendered copy; change
; the template and restart. Placeholders are substituted from env at session
; start (docs/OOD-DEPLOYMENT-DESIGN.md §1).

[supervisord]
nodaemon=true
logfile=/dev/stderr
logfile_maxbytes=0
pidfile=@STUDIO_RUNTIME_DIR@/supervisord.pid
loglevel=info

; Socket lives in the runtime dir, not /tmp directly: the runtime dir is
; per-uid, so two users on one native host don't fight over one socket path
; (and it must not be under $HOME — unix sockets can't live on NFS).
[unix_http_server]
file=@STUDIO_RUNTIME_DIR@/supervisor.sock
chmod=0700

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://@STUDIO_RUNTIME_DIR@/supervisor.sock

; ---- Studio API (FastAPI/uvicorn) ----
; Bind address: 0.0.0.0 in the container (the pod network namespace is the
; boundary), 127.0.0.1 on gated native sessions (the host is shared and the
; proxy is the only intended way in).
[program:studio-api]
command=uvicorn main:app --host @STUDIO_BIND_ADDR@ --port @STUDIO_API_PORT@
directory=@STUDIO_API_DIR@
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=10

; ---- Studio Web (Next.js standalone) ----
; Next.js standalone reads its listener from the PORT env var.
[program:studio-web]
command=node server.js
directory=@STUDIO_WEB_DIR@
environment=HOSTNAME="@STUDIO_BIND_ADDR@",PORT="@STUDIO_WEB_PORT@"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=10

; ---- JupyterLab ----
[program:jupyter]
command=@LAUNCHER_SCRIPTS@/jupyter.sh
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=10

; ---- Nginx (reverse proxy, starts last so backends are up first) ----
; -c points at the rendered nginx.conf: the distro's /etc/nginx/nginx.conf is
; ignored, so the image no longer bakes one and a host nginx needs no setup.
[program:nginx]
command=nginx -c @STUDIO_RUNTIME_DIR@/nginx.conf -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=30
