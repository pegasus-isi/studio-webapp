# Rendered by launcher/studio-launch — do not edit the rendered copy; change
# the template and restart (docs/OOD-DEPLOYMENT-DESIGN.md §1).

upstream studio_api {
    server 127.0.0.1:@STUDIO_API_PORT@;
}

upstream studio_web {
    server 127.0.0.1:@STUDIO_WEB_PORT@;
}

# WebSocket upgrade map
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen @STUDIO_PORT@;
    server_name _;

    client_max_body_size 100M;

    # Session token gate, server-level part (deny-by-default + /auth) —
    # comment-only when STUDIO_AUTH_TOKEN is unset.
    include @STUDIO_RUNTIME_DIR@/gate-server.conf;

    # Generic URL-prefix locations (STUDIO_URL_PREFIX, e.g. OOD's
    # /node/<host>/<port>) — rendered empty when no prefix is configured.
    include @STUDIO_RUNTIME_DIR@/prefix-locations.conf;

    # KubeSpawner/JupyterHub exposes the server below /user/<name>. The browser
    # must keep that prefix, but the internal Studio services route from /.
    location ~ ^/user/[^/]+$ {
        return 308 $uri/$is_args$args;
    }

    # Capture the path and let proxy_pass substitute it. NOT `rewrite ... break`
    # with a URI-less proxy_pass: that pairing sent the upstream the *original*
    # URI truncated to the rewritten URI's length, so /user/x/api/health arrived
    # as /user/kthar — right length, wrong bytes — and every API call 404'd
    # behind KubeSpawner while working fine on a direct port.
    location ~ ^/user/[^/]+(?<studio_api_path>/api(?:/.*)?)$ {
        proxy_pass http://studio_api$studio_api_path$is_args$args;
        include @STUDIO_RUNTIME_DIR@/gate-api-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE support
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # Same shape as /api above, same bug, same fix.
    location ~ ^/user/[^/]+(?<studio_ws_path>/ws(?:/.*)?)$ {
        proxy_pass http://studio_api$studio_ws_path$is_args$args;
        include @STUDIO_RUNTIME_DIR@/gate-api-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # JupyterLab is prefix-aware; jupyter.sh starts it with
    # ${JUPYTERHUB_SERVICE_PREFIX}/jupyter/ when KubeSpawner provides that env.
    location ~ ^/user/[^/]+/jupyter(?:/.*)?$ {
        proxy_pass http://127.0.0.1:@STUDIO_JUPYTER_PORT@;
        include @STUDIO_RUNTIME_DIR@/gate-jupyter-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Also affected: an asset under the prefix arrived truncated, so
    # /user/x/pegasus-ai-logo-light.png became /user/testuser/pegasus-ai and the
    # logo rendered broken. The root path survived only because its rewritten URI
    # is "/", one character, which matches the original's first character.
    location ~ ^(?<studio_prefix>/user/[^/]+)/?(?<studio_web_path>.*)$ {
        proxy_pass http://studio_web/$studio_web_path$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix $studio_prefix;

        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter 'href="/_next/' 'href="$studio_prefix/_next/';
        sub_filter 'src="/_next/' 'src="$studio_prefix/_next/';
        sub_filter 'href="./_next/' 'href="$studio_prefix/_next/';
        sub_filter 'src="./_next/' 'src="$studio_prefix/_next/';
    }

    # --- Frontend (Next.js) ---
    location / {
        proxy_pass http://studio_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js HMR WebSocket (dev only)
    location /_next/webpack-hmr {
        proxy_pass http://studio_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # --- Backend API ---
    location /api/ {
        proxy_pass http://studio_api/api/;
        include @STUDIO_RUNTIME_DIR@/gate-api-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE support
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # --- WebSocket terminals ---
    location /ws/ {
        proxy_pass http://studio_api/ws/;
        include @STUDIO_RUNTIME_DIR@/gate-api-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- JupyterLab (always-on; port default 8889, launcher-assigned) ---
    # WebSocket upgrade headers are set on the MAIN /jupyter/ location so that
    # ALL Jupyter websockets work — not just kernels/terminals, but also
    # jupyter-ai chat (/jupyter/api/ai/...) and jupyter-collaboration RTC/yjs
    # (/jupyter/api/collaboration/...). The $connection_upgrade map keeps plain
    # HTTP requests working (Connection: close when there's no Upgrade header).
    # Without this, those sockets silently fail and JupyterLab shows
    # "Unable to reconnect to the server".
    location /jupyter/ {
        proxy_pass http://127.0.0.1:@STUDIO_JUPYTER_PORT@/jupyter/;
        include @STUDIO_RUNTIME_DIR@/gate-jupyter-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
